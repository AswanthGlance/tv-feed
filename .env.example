VITE_PHOENIX_BASE_URL=
VITE_PHOENIX_PROJECT=aitv-mewtwo-harness

# Places API (New) key — must have the "Places API (New)" enabled on it.
# Deliberately NOT prefixed with VITE_: it stays server-side only (injected
# by the Vite proxy in vite.config.ts), never bundled into client JS.
# Used for: Place Details (photos, price level, opening hours) and Place
# Photo media, keyed off the place_id already present in real Phoenix
# PlaceSearch trace data. Leave blank to run with local fallback images only.
GOOGLE_PLACES_API_KEY=
