VITE_PHOENIX_BASE_URL=
VITE_PHOENIX_PROJECT=aitv-mewtwo-harness

# Places API (New) key — must have the "Places API (New)" enabled on it.
# Deliberately NOT prefixed with VITE_: it stays server-side only (injected
# by the Vite proxy in vite.config.ts), never bundled into client JS.
# Used for: Place Details (photos, price level, opening hours) and Place
# Photo media, keyed off the place_id already present in real Phoenix
# PlaceSearch trace data. Leave blank to run with local fallback images only.
# Note: a key can authenticate successfully (non-photo fields work) while
# still returning zero photos if its billing tier excludes the Photos SKU
# (confirmed with a "demo" key on 2026-08-12) — check the dev panel's GAPS
# tab / Google Places status, not just whether requests succeed.
GOOGLE_PLACES_API_KEY=

# Pexels API key (free tier, no billing card, https://www.pexels.com/api/) —
# a RELEVANT stock-photo fallback (searched by category keyword, e.g.
# "restaurant food table"), never the real entity's actual photo. Only used
# when both Google Places and the harness's own photo_url fail to resolve.
# Deliberately NOT prefixed with VITE_ — server-side only, see vite.config.ts.
# Leave blank to skip straight to local fallback images.
PEXELS_API_KEY=
